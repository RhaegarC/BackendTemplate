<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The package metadata. Fill in the properties marked as TODO below -->
    <!-- Follow the instructions on https://learn.microsoft.com/en-us/nuget/create-packages/package-authoring-best-practices -->
    <PackageId>Rg.Backend.Api</PackageId>
    <PackageVersion>1.0.0</PackageVersion>
    <Title>ASP.Net Web API Backend Solution Template</Title>
    <Authors>RhaegarC</Authors>
    <Description> A template for creating an ASP.Net Web API backend solution </Description>
    <PackageTags>Template</PackageTags>
    <PackageProjectUrl>https://github.com/RhaegarC/BackendSolutionTemplate</PackageProjectUrl>

    <!-- Keep package type as 'Template' to show the package as a template package on nuget.org and make your template available in dotnet new search.-->
    <PackageType>Template</PackageType>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup>
    <LocalizeTemplates>false</LocalizeTemplates>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.TemplateEngine.Tasks" Version="*" PrivateAssets="all" IsImplicitlyDefined="true"/>
  </ItemGroup>

  <ItemGroup>
    <!-- .idea is excluded explicitly because NoDefaultExcludes turns off the SDK's own
         dot-file skip, and pack does not read .gitignore. Without this the IDE's
         workspace.xml (absolute paths, recent files, local history) is packed and
         published, and every project generated from the template inherits it. -->
    <Content Include="content\**\*" Exclude="content\**\bin\**;content\**\obj\**;content\**\.idea\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
