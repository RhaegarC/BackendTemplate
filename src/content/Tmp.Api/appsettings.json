{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Flat keys, overridable by same-named environment variables (e.g. DbConnection=...).
  // Empty means "not configured": persistence starts without a provider and CORS fails fast.
  //
  // Nothing here is a credential. DbConnection and TenantId are left blank on purpose so
  // every clone is not handed the same values; set yours with user-secrets, which stays
  // outside the repo:
  //   dotnet user-secrets set "DbConnection" "Server=localhost;Database=Tmp;Uid=<user>;Pwd=<password>;"
  //
  // TenantId and Audience together switch on Entra ID bearer authentication. With either
  // one blank there is no scheme and every request is anonymous, which the host warns
  // about at startup. Audience is the API's Application ID URI (api://<client-id>).
  //   dotnet user-secrets set "TenantId" "<your-tenant-guid>"
  //   dotnet user-secrets set "Audience" "api://<your-api-client-id>"
  //
  // The scheme validates tokens; it does not protect endpoints by itself. An action is
  // anonymous until you put [Authorize] on it, even with both keys set.
  "DbConnection": "",
  "TenantId": "",
  "Audience": "",
  "AllowedOrigins": ""
}
