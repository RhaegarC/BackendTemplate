{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Local defaults so a freshly generated project runs without setting env vars.
  // Matches the applicationUrl values in Properties/launchSettings.json. The separator
  // is a comma here AND in launchSettings.json — that value is an environment variable,
  // so it wins over this file, and a mismatch silently rejects every origin.
  // Override with the AllowedOrigins environment variable when needed.
  "AllowedOrigins": "https://localhost:8086,http://localhost:8080"
}
