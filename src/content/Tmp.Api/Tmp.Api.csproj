<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Names this project's user-secrets store. Local dev values live there, never in the
         repo. The template engine replaces the placeholder with a fresh GUID on
         `dotnet new`, so two projects from this template do not share one store.
           dotnet user-secrets set "DbConnection" "Server=localhost;Database=Tmp;Uid=<user>;Pwd=<password>;"

         launchSettings.json deliberately carries no DbConnection or TenantId: it is
         version-controlled, so committing them hands every clone the same credentials.
         The note lives here rather than there because the SDK parses launchSettings.json
         as strict JSON and refuses to start if it contains a comment. -->
    <UserSecretsId>USER_SECRETS_ID</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tmp.Interface\Tmp.Interface.csproj" />
    <ProjectReference Include="..\Tmp.Model\Tmp.Model.csproj" />
    <ProjectReference Include="..\Tmp.Repository\Tmp.Repository.csproj" />
    <ProjectReference Include="..\Tmp.Service\Tmp.Service.csproj" />
  </ItemGroup>

  <!-- ServiceExt and the CORS guard are internal to the composition root. The guard is
       startup behaviour with no endpoint to call, so the tests reach the extension method
       directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Tmp.Tests" />
  </ItemGroup>

</Project>
